@startuml
' ============================================================================
'  E-Compra — Entity-Relationship Diagram
'  Revision 2 · 2026-11-12
'  Applies every ruling in docs/DESIGN_DECISIONS.md (see docs/DESIGN_REVIEW.md
'  for the findings). Revision 1 is preserved in ./archive-v1-original/.
' ============================================================================
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFC
  BorderColor #36546C
  ArrowColor #526B7A
}
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2E5E8C
  ArrowColor #526B7A
}

' ================= Core / Users =================
entity "User (Django built-in)" as User {
  *id: int
  --
  username: str
  email: str
  -password_hash: managed by Django
}

entity UserProfile {
  *user: User (FK, PK)
  --
  is_vendor: bool
  created_at: datetime
  updated_at: datetime
}

entity CustomerProfile {
  *user: User (FK, PK)
  --
  phone: str
  address: text
  created_at: datetime
  updated_at: datetime
}

' ================= Catalog =================
entity "Market Vendor (catalog.Vendor)" as CatalogVendor {
  *id: int
  --
  name: str
  stall_location: str
  market_section: str
  contact_phone: str
  contact_email: str
  is_active: bool
  user: User (FK, UK)          ' NOT NULL - every storefront has an owner
  created_at: datetime
  updated_at: datetime
}

entity "POS Vendor (vendors.Vendor)" as PosVendor {
  *catalog_vendor: CatalogVendor (FK, PK)   ' 1:1 extension, not a 2nd user link
  --
  stall_name: str
  stall_location: str
}

entity Category {
  *id: int
  --
  name: str
  slug: str (UK)
  is_active: bool
  created_at: datetime
  updated_at: datetime
}

entity UnitOfMeasure {
  *code: str (PK)
  --
  name: str
  description: str
  is_active: bool
  created_at: datetime
  updated_at: datetime
}

entity ComparisonGroup {
  *code: str (PK)
  --
  name: str
  base_unit: UnitOfMeasure (FK)
  description: str
  is_active: bool
  created_at: datetime
  updated_at: datetime
}

entity ComparisonGroupUnit {
  *id: int
  --
  comparison_group: ComparisonGroup (FK)
  unit: UnitOfMeasure (FK)
  factor_to_base: decimal      ' 1 pc = 0.25 kg -> factor_to_base = 0.25
  unique_together (comparison_group, unit)
}

entity AvailabilityStatus {
  *code: str (PK)
  --
  description: str
  sort_order: int
  is_orderable: bool
}

entity Product {
  *id: int
  --
  name: str
  description: text
  image_url: url
  price: decimal
  unit: UnitOfMeasure (FK)     ' must be a member of comparison_group's allowed units
  stall_location: str
  availability: AvailabilityStatus (FK)
  stock_quantity: int          ' default 0 - maintained by the inventory trigger
  low_stock_threshold: int     ' default 5
  category: Category (FK)
  vendor: CatalogVendor (FK)
  comparison_group: ComparisonGroup (FK, null)
  created_at: datetime
  updated_at: datetime
}

entity InventoryReason {
  *code: str (PK)
  --
  description: str
  direction: str               ' IN | OUT | ADJUST
}

entity InventoryMovement {
  *id: int
  --
  product: Product (FK)
  delta: int                   ' +received / -sold
  reason: InventoryReason (FK)
  order: Order (FK, null)      ' set when the movement came from a sale
  note: str
  created_at: datetime
}

' ================= Cart =================
entity Cart {
  *user: User (FK, PK)
  --
  created_at: datetime
}

entity CartItem {
  *id: int
  --
  quantity: int
  cart: Cart (FK)
  product: Product (FK)
  created_at: datetime
  unique_together (cart, product)
}

' ================= Lookups =================
entity TransactionType {
  *code: str (PK)
  --
  description: str
}

entity TransactionStatus {
  *code: str (PK)
  --
  description: str
  sort_order: int
}

entity FulfillmentMethod {
  *code: str (PK)
  --
  description: str
}

entity PaymentStatus {
  *code: str (PK)
  --
  description: str
  is_terminal: bool
}

entity DeliveryStatus {
  *code: str (PK)
  --
  description: str
  is_terminal: bool
}

' ================= Orders / Payments / Delivery =================
entity Order {
  *id: int
  --
  user: User (FK, null)        ' NULL only for anonymous WALK_IN sales
  customer_label: str (null)   ' walk-in name, when there is no User row
  vendor: CatalogVendor (FK)   ' NOT NULL - one order = one vendor
  status: TransactionStatus (FK)
  fulfillment_type: FulfillmentMethod (FK)
  total_amount: decimal
  notes: text
  created_at: datetime
  updated_at: datetime
}

entity OrderItem {
  *id: int
  --
  order: Order (FK)
  product: Product (FK)
  quantity: int
  unit_price: decimal          ' price snapshot at order time
  created_at: datetime
}

entity Transaction {
  *id: int
  --
  order: Order (FK, 1:1)
  transaction_type: TransactionType (FK)
  reference_no: str (UK)
  created_at: datetime
  updated_at: datetime
}

entity Payment {
  *id: int
  --
  transaction: Transaction (FK)
  provider: str                ' GCASH | MAYA | BANK | CARD | CASH
  provider_reference: str
  amount: decimal
  status: PaymentStatus (FK)
  raw_response: json
  paid_at: datetime
  created_at: datetime
  unique_together (provider, provider_reference)
}

entity DeliveryBooking {
  *id: int
  --
  transaction: Transaction (FK, 1:1)
  provider: str                ' GRABEXPRESS | LALAMOVE | MAXIM | LOCAL
  booking_reference: str
  tracking_url: url
  fee: decimal
  status: DeliveryStatus (FK)
  raw_response: json
  booked_at: datetime
  delivered_at: datetime
  created_at: datetime
  updated_at: datetime
}

entity "Vendor POS Transaction (vendors.VendorTransaction)" as VendorTx {
  *id: int
  --
  vendor: PosVendor (FK)
  order: Order (FK, 1:1)
  status: TransactionStatus (FK)
  receipt_serial: str (null, blank)   ' RC-{reference_no}-{attempt}
  receipt_attempt: int                ' default 1; increments on reprint
  created_at: datetime
}

' ================= Favorites =================
entity FavoriteProduct {
  *id: int
  --
  user: User (FK)
  product: Product (FK)
  created_at: datetime
  unique_together (user, product)
}

entity FavoriteVendor {
  *id: int
  --
  user: User (FK)
  vendor: CatalogVendor (FK)
  created_at: datetime
  unique_together (user, vendor)
}

' ================= Relationships =================
User ||--o| UserProfile : extends
User ||--o| CustomerProfile : extends
User ||--o| CatalogVendor : owns storefront
User ||--o| Cart : owns active cart

Cart ||--o{ CartItem : contains
CartItem }o--|| Product : references

CatalogVendor ||--o| PosVendor : POS extension
CatalogVendor ||--o{ Product : sells
Category ||--o{ Product : classifies
AvailabilityStatus ||--o{ Product : availability of
UnitOfMeasure ||--o{ Product : priced per
UnitOfMeasure ||--o{ ComparisonGroup : base unit of
ComparisonGroup ||--o{ ComparisonGroupUnit : allows
UnitOfMeasure ||--o{ ComparisonGroupUnit : unit
ComparisonGroup ||--o{ Product : groups

Product ||--o{ InventoryMovement : stock changes
InventoryReason ||--o{ InventoryMovement : reason
Order ||--o{ InventoryMovement : caused by

User ||--o{ Order : places
CatalogVendor ||--o{ Order : fulfills

Order ||--|{ OrderItem : contains
OrderItem }o--|| Product : is product
Order ||--o| Transaction : linked transaction
Order ||--o| VendorTx : vendor POS record

TransactionType ||--o{ Transaction : classifies
Transaction ||--o{ Payment : payment attempts
Transaction ||--o| DeliveryBooking : delivery booking
Payment }o--|| PaymentStatus : has status
DeliveryBooking }o--|| DeliveryStatus : has status

User ||--o{ FavoriteProduct : favorites
Product ||--o{ FavoriteProduct : favorited product
User ||--o{ FavoriteVendor : favorites
CatalogVendor ||--o{ FavoriteVendor : favorited vendor

PosVendor ||--o{ VendorTx : handles

note right of Order
  One Order holds products from ONE vendor only (vendor NOT NULL).
  Multi-vendor checkout = one Order per vendor
  (split in OrderListCreateView.post), each with its own Transaction,
  its own Payment and - for delivery - its own DeliveryBooking.

  WALK_IN sales (vendor POS) are Orders with user = NULL and
  fulfillment_type = WALK_IN, so anonymous buyers need no User row.
end note

note right of Payment
  unique_together (provider, provider_reference)
  guarantees idempotency - no double charges.
  Store provider references/status only, never
  raw card numbers or banking passwords.
  CASH payments are recorded here too (provider = 'CASH',
  provider_reference = the receipt serial), so all money received
  lives in one table.
end note

note right of DeliveryBooking
  One-to-one with Transaction. Created only for
  DELIVERY fulfillment after payment is verified.
  Pickup orders have no delivery booking.
  delivery_status IN_TRANSIT / DELIVERED plus delivered_at
  are written by the vendor's out-for-delivery / delivered actions.
end note

note right of VendorTx
  Vendor POS record linked to an Order.
  receipt_serial generated on cash payment:
  RC-{transaction.reference_no}-{receipt_attempt}.
  receipt_attempt increments on every reprint, so a reprinted
  receipt keeps the same serial and stays auditable.
end note

note bottom of Transaction
  Transaction is a linked commercial record (reference_no +
  transaction_type), NOT the order itself. Order is the order entity.
  transaction_type separates ONLINE_ORDER, PICKUP_RESERVATION
  and POS_WALKIN - this is what makes "show me all reservations"
  answerable without guessing from status.

  Transaction carries NO status of its own. Lifecycle lives once, on
  Order.status; settlement lives once, on Payment.status. Storing a
  third copy here would be a second authority for the same fact with
  nothing keeping the two in step.
end note

note bottom of TransactionStatus
  Seeded codes:
  PENDING_PAYMENT, CONFIRMED, PREPARING, READY_FOR_PICKUP,
  OUT_FOR_DELIVERY, COMPLETED, CANCELLED
end note

note bottom of PaymentStatus
  Seeded codes: PENDING, VERIFIED, FAILED, REFUNDED
end note

note bottom of DeliveryStatus
  Seeded codes: BOOKED, IN_TRANSIT, DELIVERED, FAILED, CANCELLED
end note

note bottom of FulfillmentMethod
  Seeded codes: PICKUP, DELIVERY, WALK_IN
end note

note bottom of TransactionType
  Seeded codes: ONLINE_ORDER, PICKUP_RESERVATION, POS_WALKIN
end note

note bottom of InventoryReason
  Seeded codes: RECEIVED (IN), SOLD_ONLINE (OUT),
  SOLD_WALKIN (OUT), SPOILAGE (OUT), ADJUSTMENT (ADJUST)
end note

note bottom of AvailabilityStatus
  Seeded codes: IN_STOCK, LOW_STOCK, OUT_OF_STOCK, HIDDEN
end note

@enduml
